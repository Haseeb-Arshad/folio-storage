{
  "name": "drive-alternative-backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target node --splitting --format esm --external=@aws-sdk/* --external=@supabase/* --external=express --external=jsonwebtoken --external=multer --external=uuid --external=zod --external=cors --external=dotenv --external=helmet --external=express-rate-limit",
    "prod": "NODE_ENV=production bun run start",
    "serve": "NODE_ENV=production bun run ./dist/index.js",
    "clean": "node scripts/cleanup.js",
    "rebuild": "npm run clean && npm run build",
    "lint": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "test:r2": "bun run build && node test-r2.mjs",
    "test:r2-cjs": "bun run build && node test-r2.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.826.0",
    "@aws-sdk/s3-request-presigner": "^3.826.0",
    "@pinata/sdk": "^latest",
    "@supabase/supabase-js": "^latest",
    "cors": "^latest",
    "dotenv": "^latest",
    "express": "^latest",
    "express-rate-limit": "^latest",
    "helmet": "^latest",
    "jsonwebtoken": "^latest",
    "multer": "^latest",
    "uuid": "^11.1.0",
    "zod": "^latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^latest",
    "@types/uuid": "^10.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
